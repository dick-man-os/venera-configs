  "baseUrl": "https://www.311s.com",
  "explore": {
    "popular": {
      "selector": "div.comic-list > div.comic-item",
      "fields": {
        "title": "h3 a",
        "url": "a@href",
        "thumbnail": "img@src"
      },
      "manualPatchRequired": false,
      "pagination": {
        "hasNextStrategy": "compareAttributes",
        "nextSelector": "div.pagination > a.next",
        "currentSelector": "div.pagination > a.on",
        "attribute": "href"
      },
      "url": "{{baseUrl}}/category/order/hits/page/{{page}}",
      "method": "GET"
    },
    "latest": {
      "selector": "div.comic-list > div.comic-item",
      "fields": {
        "title": "h3 a",
        "url": "a@href",
        "thumbnail": "img@src"
      },
      "manualPatchRequired": false,
      "pagination": {
        "hasNextStrategy": "compareAttributes",
        "nextSelector": "div.pagination > a.next",
        "currentSelector": "div.pagination > a.on",
        "attribute": "href"
      },
      "url": "{{baseUrl}}/category/order/addtime/page/{{page}}",
      "method": "GET"
    }
  },
  "search": {
    "selector": "div.comic-list > div.comic-item",
    "fields": {
      "title": "h3 a",
      "url": "a@href",
      "thumbnail": "img@src"
    },
    "manualPatchRequired": false,
    "pagination": {
      "hasNextStrategy": "compareAttributes",
      "nextSelector": "div.pagination > a.next",
      "currentSelector": "div.pagination > a.on",
      "attribute": "href"
    },
    "url": "{{baseUrl}}/search/{{query}}/{{page}}",
    "method": "GET"
  },
  "details": {
    "url": "{{comicUrl}}",
    "method": "GET",
    "selector": "html",
    "fields": {
      "title": "div.comic-meta-info > h1",
      "thumbnail": "div.comic-cover-large > img@src",
      "description": "div.comic-description > p"
    },
    "manualPatchRequired": true
  },
  "chapters": {
    "url": "{{comicUrl}}",
    "method": "GET",
    "isJson": false,
    "selector": "#chapter-list > div.chapter-item > a",
    "fields": {
      "url": "@href",
      "name": "text"
    },
    "reverse": true,
    "manualPatchRequired": false
  },
  "pages": {
    "url": "{{chapterUrl}}",
    "method": "GET",
    "selector": "div.comic-content > img",
    "fields": {
      "imageUrl": "@src"
    },
    "manualPatchRequired": false
  },
